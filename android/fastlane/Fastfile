default_platform(:android)

platform :android do
  desc "Build Flutter AAB and upload to Play Store (default: internal track)"
  lane :deploy do |options|
    track = options[:track] || "internal"

    Dir.chdir("../..") do
      # CARTO_API_KEY for the map tiles; `just carto-key` writes this file.
      UI.user_error!("dart_defines.local.json missing: run `just carto-key` (the map would be blank)") unless File.exist?("dart_defines.local.json")
      sh("flutter build appbundle --release --dart-define-from-file=dart_defines.local.json")
    end

    upload_to_play_store(
      track: track,
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
